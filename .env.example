# HTTP Basic Auth fence (middleware). Set both — if either is missing
# the app returns 503 to fail closed. Set these in Vercel for the
# deployed env.
BASIC_USER=admin
BASIC_PASS=changeme

# Anthropic API key. Get one from console.anthropic.com with billing
# enabled (NOT a Claude Pro subscription). Used by Haiku 4.5 for
# per-source / case summaries and Opus 4.8 for tool generations.
ANTHROPIC_API_KEY=sk-ant-...
