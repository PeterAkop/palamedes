# HTTP Basic Auth fence (middleware). Set both — if either is missing
# the app returns 503 to fail closed. Set these in Vercel for the
# deployed env.
BASIC_USER=admin
BASIC_PASS=changeme

# Anthropic API key. Get one from console.anthropic.com with billing
# enabled (NOT a Claude Pro subscription). Used by Haiku 4.5 for
# per-source / case summaries and Opus 4.8 for tool generations.
# Model IDs are centralised in src/lib/anthropic.ts.
ANTHROPIC_API_KEY=sk-ant-...

# Vercel Blob (private store) for uploaded source files. Provision via
# Vercel Storage → Blob → Connect; copy the read-write token.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Outlook / Microsoft Graph integration (Phase A.2 — pull-on-demand).
# Register a multitenant+personal ("common") app in Entra ID with
# delegated Mail.Read / offline_access / User.Read and a Web redirect
# URI of <app-origin>/api/integrations/outlook/callback. See plan.md §2.
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=...
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:3000/api/integrations/outlook/callback
# 32-byte base64 key for encrypting stored OAuth tokens at rest.
# Generate with: openssl rand -base64 32
MS_TOKEN_ENC_KEY=...

# Auth.js (NextAuth v5) — "Sign in with Microsoft". Users live in our own
# Postgres (Drizzle adapter). The same Azure app registration as the
# Outlook connection can host sign-in — just add the redirect URI
# <origin>/api/auth/callback/microsoft-entra-id to it.
AUTH_SECRET=...                                  # openssl rand -base64 33
AUTH_MICROSOFT_ENTRA_ID_ID=...                   # Azure app client id
AUTH_MICROSOFT_ENTRA_ID_SECRET=...               # Azure app client secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Neon Postgres. Provisioned via Vercel Storage → Neon. Two URLs:
#   DATABASE_URL          — pooled (PgBouncer transaction-mode). Used
#                            by the app at runtime via the Neon HTTP
#                            driver in src/db/db.ts.
#   DATABASE_URL_UNPOOLED — direct connection. Used by drizzle-kit
#                            migrate / studio (DDL doesn't play with
#                            transaction-mode pooling).
DATABASE_URL=postgres://...
DATABASE_URL_UNPOOLED=postgres://...
